<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Alias used in the manifest. Default is Niezapominajka (lavender). -->
    <style name="Theme.ReminderAlarm" parent="Theme.ReminderAlarm.ForgetMeNot" />

    <style name="Theme.ReminderAlarm.ForgetMeNot" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#C4ADE8</item>
        <item name="colorPrimaryDark">#8B70B8</item>
        <item name="colorAccent">#5BC0EB</item>
        <item name="colorSecondary">#5BC0EB</item>
    </style>

    <!-- Typography overrides shared by every palette: medium weight for
         headlines/titles (closer to Inter's "Medium") and regular for
         body. Applied via the android:textAppearance* theme attrs so it
         affects toolbar titles, material dialogs, and list items
         without touching individual layouts. -->
    <style name="TextAppearance.ReminderAlarm.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.ReminderAlarm.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.ReminderAlarm.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.ReminderAlarm.Blue" parent="Theme.MaterialComponents.DayNight.NoActionBar">
