    <string name="perm_notif_title">Powiadomienia</string>
    <string name="perm_notif_desc">Android 13+ wymaga osobnej zgody na powiadomienia. Bez niej alarm się nie pojawi.</string>

    <string name="perm_exact_title">Dokładne alarmy</string>
    <string name="perm_exact_desc">Żeby alarm uruchomił się dokładnie o wybranej godzinie, a nie za kilka minut.</string>

    <string name="perm_fullscreen_title">Alarm na pełnym ekranie</string>
    <string name="perm_fullscreen_desc">Android 14+ wymaga zgody, żeby aplikacja mogła pokazać się na całym ekranie przy dzwoniącym alarmie.</string>

    <string name="perm_overlay_title">Wyświetlanie nad innymi aplikacjami</string>
    <string name="perm_overlay_desc">Żeby alarm pokazał się nawet gdy używasz innej aplikacji lub gier.</string>

    <string name="perm_battery_title">Wyłącz oszczędzanie baterii</string>
    <string name="perm_battery_desc">Android bez tego może zamknąć aplikację w tle — alarm wtedy nie zadzwoni.</string>

    <string name="perm_location_title">Lokalizacja</string>
    <string name="perm_location_desc">Wymagane tylko dla przypomnień uruchamianych po wejściu w określone miejsce (np. „kup mleko w Biedronce\").</string>

    <string name="perm_mic_title">Mikrofon</string>
    <string name="perm_mic_desc">Wymagane tylko dla funkcji dyktowania treści przypomnień.</string>

